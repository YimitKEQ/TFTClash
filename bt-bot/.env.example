# BrosephTech Bot - environment configuration
# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- Discord ----------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot tab).
BT_DISCORD_TOKEN=your-bot-token-here

# Application (client) id from the Discord Developer Portal (General Information).
BT_CLIENT_ID=your-application-id-here

# The id of the BrosephTech Discord server the bot operates in.
BT_GUILD_ID=your-guild-id-here

# Where the daily standup is posted. Accepts a channel name (substring match)
# or a raw channel id. Defaults to a channel named "bt-standup".
BT_STANDUP_CHANNEL=bt-standup

# ---- Supabase (READ-ONLY usage of the shared content board) -----------------
# Same Supabase project that backs the content board. The bot only reads
# bt_content_cards. Keep the service role key secret and server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Crew to Discord mapping ------------------------------------------------
# JSON object mapping a crew member's board name to their Discord user id.
# Members without an entry are still tracked, but get a bold name instead of a
# real ping. Example:
# BT_CREW_DISCORD={"Levitate":"111111111111111111","Broseph":"222222222222222222"}
BT_CREW_DISCORD={}

# ---- Live feed --------------------------------------------------------------
# The live feed needs no extra config. It subscribes to Supabase realtime on
# bt_content_cards and announces new / shipped / blocked cards to the HQ
# channels (bt-board, bt-wins, bt-blocked, and the per-department channels).
# Make sure realtime is enabled for bt_content_cards in the Supabase project.

# ---- Misc -------------------------------------------------------------------
# IANA timezone used for the standup, nudge, weekly digest, and blocked sweep
# cron schedules.
TIMEZONE=Europe/London

# ---- Meeting capture (optional AI) ------------------------------------------
# If set, /meeting uses the Claude API to summarize notes and extract tasks.
# Without it, a built-in rule-based parser is used instead (no key required).
ANTHROPIC_API_KEY=
# Model for meeting extraction. Cheap + fast is ideal here.
ANTHROPIC_MODEL=claude-haiku-4-5
# Channel for meeting recaps (name substring or id). Defaults to bt-meetings.
BT_MEETINGS_CHANNEL=bt-meetings
