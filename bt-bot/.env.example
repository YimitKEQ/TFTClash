# BrosephTech Bot - environment configuration
# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- Discord ----------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot tab).
BT_DISCORD_TOKEN=your-bot-token-here

# Application (client) id from the Discord Developer Portal (General Information).
BT_CLIENT_ID=your-application-id-here

# The id of the BrosephTech Discord server the bot operates in.
BT_GUILD_ID=your-guild-id-here

# Where the daily standup is posted. Accepts a channel name (substring match)
# or a raw channel id. Defaults to a channel named "bt-standup".
BT_STANDUP_CHANNEL=bt-standup

# ---- Supabase (READ-ONLY usage of the shared content board) -----------------
# Same Supabase project that backs the content board. The bot only reads
# bt_content_cards. Keep the service role key secret and server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Crew to Discord mapping ------------------------------------------------
# JSON object mapping a crew member's board name to their Discord user id.
# Members without an entry are still tracked, but get a bold name instead of a
# real ping. Example:
# BT_CREW_DISCORD={"Levitate":"111111111111111111","Broseph":"222222222222222222"}
BT_CREW_DISCORD={}

# ---- Live feed --------------------------------------------------------------
# The live feed needs no extra config. It subscribes to Supabase realtime on
# bt_content_cards and announces new / shipped / blocked cards to the HQ
# channels (bt-board, bt-wins, bt-blocked, and the per-department channels).
# Make sure realtime is enabled for bt_content_cards in the Supabase project.

# ---- Misc -------------------------------------------------------------------
# IANA timezone used for the standup, nudge, weekly digest, and blocked sweep
# cron schedules.
TIMEZONE=Europe/London

# ---- Meeting capture (optional AI) ------------------------------------------
# If set, /meeting uses the Claude API to summarize notes and extract tasks.
# Without it, a built-in rule-based parser is used instead (no key required).
ANTHROPIC_API_KEY=
# Model for meeting extraction. Cheap + fast is ideal here.
ANTHROPIC_MODEL=claude-haiku-4-5
# Channel for meeting recaps (name substring or id). Defaults to bt-meetings.
BT_MEETINGS_CHANNEL=bt-meetings

# ---- Voice recording: local whisper.cpp (for /record) -----------------------
# /record joins your voice channel, records each speaker on a separate track,
# and transcribes locally with whisper.cpp (audio never leaves the machine).
# You must build/download whisper.cpp and a ggml model once. See README.
#
# Full path to the whisper.cpp executable (whisper-cli.exe or main.exe).
WHISPER_CMD=C:\tools\whisper.cpp\whisper-cli.exe
# Full path to a ggml model. base.en is a good speed/quality default;
# small.en or medium.en are more accurate but slower on CPU.
WHISPER_MODEL=C:\tools\whisper.cpp\models\ggml-base.en.bin
# Language code, or "auto" to detect. Default en.
WHISPER_LANG=en
# Per-track transcription timeout in ms (default 900000 = 15 min).
WHISPER_TIMEOUT_MS=900000

# ---- Jira Cloud (for /record task push) -------------------------------------
# Approved tasks are pushed to this Jira Cloud project as issues.
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=BT
# Issue type to create (default Task). Must exist in the project.
JIRA_ISSUE_TYPE=Task
# Set to 1 to also set the Jira priority field (only if it is on the create
# screen for this project, otherwise leave unset to avoid errors).
JIRA_SET_PRIORITY=

# ---- Browser dashboard (/dashboard + web command center) --------------------
# The bot serves a dark, auto-refreshing web dashboard of the whole board.
# It only starts when DASHBOARD_TOKEN is set. Use a long random string; open it
# at http://HOST:PORT/?k=YOUR_TOKEN (the token is then stored in a cookie).
DASHBOARD_TOKEN=
# Port to listen on (default 8787).
DASHBOARD_PORT=8787
# Bind address. 127.0.0.1 = this machine only (default). Set 0.0.0.0 to expose
# it for a tunnel (e.g. cloudflared / ngrok) so the crew can reach it.
DASHBOARD_HOST=127.0.0.1
# If you tunnel it, put the public https URL here so the Discord /dashboard
# command can show an "Open web dashboard" link button.
DASHBOARD_PUBLIC_URL=
